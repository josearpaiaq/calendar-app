# Backend .env — read by the Go server and the seed script (godotenv).
# Copy to backend/.env and fill in the blanks.

# --- HTTP server -------------------------------------------------
PORT=8080
# Comma-separated list of allowed CORS origins
# Example: http://localhost:5173,https://myapp.com
CORS_ORIGINS=http://localhost:5173
# Directory for uploaded event images (served at /uploads)
UPLOADS_DIR=./uploads

# --- PostgreSQL connection ---------------------------------------
# DB_USER / DB_PASSWORD / DB_NAME / DB_PORT must match the root .env
# (Docker Compose provisions the database with those values).
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=calendardb
DB_SSLMODE=disable

# --- Auth ---------------------------------------------------------
# Secret used to sign JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=

# --- Seed script (go run ./cmd/seed) ------------------------------
# Credentials for the initial login user
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
