# Frontend .env — read by Vite (dev server and build).
# Copy to frontend/.env.

# --- Vite dev proxy (Node only, never exposed to the browser) -----
# Where `npm run dev` proxies /api and /uploads
BACKEND_URL=http://localhost:8080

# --- Browser bundle ------------------------------------------------
# Backend base URL baked into the client (import.meta.env.VITE_API_URL).
# Must always be DEFINED — the API client builds its base URL from it:
#   dev:  leave empty, the Vite proxy handles /api and /uploads
#   prod: full public backend URL, e.g. https://api.myapp.com
VITE_API_URL=
