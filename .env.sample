# Root .env — read ONLY by Docker Compose (docker-compose.yml).
# Copy to .env and fill in the credentials.

# --- PostgreSQL container ---------------------------------------
# Keep DB_USER / DB_PASSWORD / DB_NAME / DB_PORT in sync with
# backend/.env — Compose provisions the database with these values.
DB_USER=
DB_PASSWORD=
DB_NAME=calendardb
# Host port mapped to the container's 5432
DB_PORT=5432

# --- pgAdmin (http://localhost:5051) ----------------------------
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
